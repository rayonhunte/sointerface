{
    "compilerOptions": {
        "target": "ES2019", // Specifies the target ECMAScript version.
        "module": "ESNext", // Module code generation.
        "lib": [
            "DOM",
            "ES2019"
        ], // Include DOM and ES2019 library files.
        "jsx": "react-jsx", // Support for JSX in React.
        "moduleResolution": "Node", // How module imports are resolved.
        "esModuleInterop": true, // Enables interoperability between CommonJS and ES Modules.
        "allowSyntheticDefaultImports": true, // Allow default imports from modules with no default export.
        "declaration": true, // Generates corresponding '.d.ts' files.
        "declarationMap": true, // Generates source maps for '.d.ts' files.
        "sourceMap": true, // Generates source map files.
        "strict": true, // Enable all strict type-checking options.
        "noImplicitAny": true, // Raise error on expressions and declarations with an implied 'any' type.
        "forceConsistentCasingInFileNames": true, // Disallow inconsistently-cased references to the same file.
        "skipLibCheck": true, // Skip type checking of declaration files.
        "composite": true // Enable project references.
    },
    "include": [
        "packages/*/src",
        "apps/*/src"
, "packages/input/tsconfig.json"    ], // Include all source files in packages and apps directories.
    "exclude": [
        "node_modules",
        "dist"
    ] // Exclude node_modules and dist directories.
}